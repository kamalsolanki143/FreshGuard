# ==========================================
# FRESHGUARD VERIFICATION SERVICE CONFIGURATION
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
SERVICE_NAME=freshguard-verification
VERSION=1.0.0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Database Settings
# Local SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./freshguard.db
# Production Neon Serverless PostgreSQL (recommended for Render free tier persistent storage):
# DATABASE_URL=postgresql+asyncpg://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# LLM Provider Configuration (mock, openai, gemini)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RETRIES=2

# Google Gemini Developer API Settings (when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# ==========================================
# AUTHENTICATION (X-API-Key)
# ==========================================
# API_AUTH_MODE controls request-level authentication on /v1/verifications endpoints.
#   disabled - No authentication (development/test only; forbidden in staging & production).
#   warn     - Invalid/missing key logs a warning but request is allowed (staging/development/test).
#   enforce  - Valid X-API-Key is mandatory; missing/wrong key returns HTTP 401.
# Production (ENVIRONMENT=production) STRICTLY requires API_AUTH_MODE=enforce and a valid key.
API_AUTH_MODE=disabled

# VERIFICATION_SERVICE_API_KEY — the shared secret callers must send as X-API-Key.
# Required when API_AUTH_MODE=enforce.
# Generate: openssl rand -hex 32
# NEVER commit a real key. NEVER log this value.
VERIFICATION_SERVICE_API_KEY=

# Tavily Evidence Search Configuration
TAVILY_API_KEY=
TAVILY_TIMEOUT=10.0
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5

# Default Freshness Policy TTLs (in seconds)
TTL_SOFTWARE_VERSION=86400      # 24 hours
TTL_PRICING=21600               # 6 hours
TTL_LEADERSHIP=86400            # 24 hours
TTL_PRODUCT_AVAILABILITY=3600   # 1 hour
TTL_RECENT_EVENTS=21600         # 6 hours
TTL_STATISTICS=86400            # 24 hours
TTL_GENERAL_KNOWLEDGE=2592000   # 30 days
TTL_GENERAL=43200               # 12 hours

