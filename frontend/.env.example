# FreshGuard Frontend Environment Variables

# Local Vite Proxy Target (Default: http://localhost:8000)
VITE_BACKEND_URL=http://localhost:8000

# Optional Direct Backend API URL (Omit to use same-origin /api proxy on Cloudflare Pages)
# VITE_API_URL=https://freshguard-verification.onrender.com

# Shared API Key injected by local Vite dev proxy or Cloudflare Pages Function
# NEVER commit real keys to git
# VERIFICATION_SERVICE_API_KEY=your_secret_api_key_here
