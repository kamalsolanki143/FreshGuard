{
  "name": "freshguard-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "qa": "node run_browser_qa.cjs",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@react-spring/web": "^9.7.0",
    "@react-three/drei": "^9.83.0",
    "@react-three/fiber": "^8.15.11",
    "autoprefixer": "^10.6.2",
    "framer-motion": "^11.5.0",
    "lucide-react": "^0.359.0",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^3.4.19",
    "three": "^0.168.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.2",
    "prettier": "^3.3.3",
    "puppeteer-core": "^25.17.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.1"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "env": {
      "browser": true,
      "node": true
    },
    "parserOptions": {
      "ecmaVersion": 2020,
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true,
        "modules": true
      }
    },
    "rules": {
      "react/react-in-jsx-scope": "off"
    }
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "trailingComma": "es5",
    "printWidth": 100
  }
}
