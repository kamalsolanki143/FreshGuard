{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FreshGuardVerificationAPI",
  "description": "Shared contract for FreshGuard Python Verification Service and Go Bifrost Gateway Adapter",
  "definitions": {
    "Evidence": {
      "type": "object",
      "required": ["evidence_id", "source_url", "snippet", "retrieved_at"],
      "properties": {
        "evidence_id": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" },
        "source_title": { "type": "string" },
        "snippet": { "type": "string" },
        "published_at": { "type": ["string", "null"] },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "source_type": { "type": "string", "enum": ["official_docs", "news", "website", "other"] }
      }
    },
    "Claim": {
      "type": "object",
      "required": ["claim_id", "category", "entity", "attribute", "original_text", "verdict", "confidence", "checked_at"],
      "properties": {
        "claim_id": { "type": "string" },
        "category": { "type": "string", "enum": ["pricing", "software_version", "leadership"] },
        "entity": { "type": "string" },
        "attribute": { "type": "string" },
        "original_text": { "type": "string" },
        "verdict": { "type": "string", "enum": ["supported", "contradicted", "unclear"] },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "corrected_value": { "type": ["string", "null"] },
        "checked_at": { "type": "string", "format": "date-time" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/definitions/Evidence" }
        }
      }
    },
    "APIError": {
      "type": "object",
      "required": ["code", "message", "request_id", "retryable"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "request_id": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    }
  },
  "oneOf": [
    {
      "title": "VerificationRequest",
      "type": "object",
      "required": ["request_id", "text", "mode"],
      "properties": {
        "request_id": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["blocking", "async"] },
        "categories": {
          "type": "array",
          "items": { "type": "string", "enum": ["pricing", "software_version", "leadership"] }
        }
      }
    },
    {
      "title": "VerificationResponse",
      "type": "object",
      "required": ["verification_id", "request_id", "status"],
      "properties": {
        "verification_id": { "type": "string" },
        "request_id": { "type": "string" },
        "status": { "type": "string", "enum": ["accepted", "completed", "failed"] },
        "result_url": { "type": ["string", "null"] },
        "checked_at": { "type": ["string", "null"], "format": "date-time" },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/definitions/Claim" }
        },
        "error": { "$ref": "#/definitions/APIError" }
      }
    }
  ]
}

